// HANDYO — home services, one database, many shops.
// A Shop is a branch (our own, e.g. Cox's Bazar Sadar, Dhaka) or a partner
// business on the platform. Areas, services, workers, staff, bookings, chats,
// tickets, templates and settings all belong to one shop; customers are shared.
// Roles: CUSTOMER, WORKER, SUPPORT, ADMIN (one shop), OWNER (every shop).
// Money is whole BDT (৳).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A branch or partner shop. Everything operational hangs off one of these.
model Shop {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameBn    String
  city      String
  cityBn    String
  /// BRANCH = our own branch, PARTNER = an independent business on the platform.
  kind      String   @default("BRANCH")
  phone     String   @default("")
  whatsapp  String   @default("")
  email     String   @default("")
  address   String   @default("")
  addressBn String   @default("")
  blurb     String   @default("")
  blurbBn   String   @default("")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  users       User[]
  workers     WorkerProfile[]
  ticketStocks TicketStock[]
  areas       ServiceArea[]
  categories  ServiceCategory[]
  bookings    ServiceBooking[]
  careThreads CareThread[]
  tickets     Ticket[]
  templates   ReplyTemplate[]
  settings    Setting[]
  vehicles    Vehicle[]
  coupons     Coupon[]
  properties  Property[]
  productGroups ProductGroup[]
  products     Product[]
  stores       Store[]
}

/// A discount code of one shop. PERCENT takes `value` % off the work price
/// (capped by maxDiscount when set); FIXED takes `value` taka off.
model Coupon {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code        String
  kind        String    @default("PERCENT")
  value       Int
  minAmount   Int       @default(0)
  maxDiscount Int       @default(0)
  /// Only this category when set.
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startsAt    DateTime?
  endsAt      DateTime?
  /// 0 = unlimited
  usageLimit  Int       @default(0)
  usedCount   Int       @default(0)
  /// Uses per customer; 0 = unlimited
  perCustomer Int       @default(1)
  note        String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  bookings ServiceBooking[]

  @@unique([shopId, code])
  @@index([shopId, active])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         String   @default("CUSTOMER")
  /// Staff and workers belong to one shop. Customers and owners have none.
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// Helper accounts: a partner's staff who work inside the partner's panel (max 2, approved by the HANDYO office).
  helperOfId   String?
  helperOf     WorkerProfile? @relation("Helpers", fields: [helperOfId], references: [id], onDelete: SetNull)
  /// "" (not a helper), PENDING, APPROVED, REJECTED
  helperStatus String   @default("")

  worker         WorkerProfile?
  addresses      Address[]
  requests       ChangeRequest[]      @relation("RequestedBy")
  decisions      ChangeRequest[]      @relation("DecidedBy")
  bookings       ServiceBooking[]     @relation("BookingCustomer")
  bookingEvents  BookingEvent[]
  bookingPhotos  BookingPhoto[]
  reviews        BookingReview[]
  bookingChats   BookingChatMessage[]
  careThreads    CareThread[]         @relation("CareCustomer")
  careAssigned   CareThread[]         @relation("CareAssignee")
  careMessages   CareMessage[]
  tickets        Ticket[]             @relation("TicketOwner")
  ticketsAssigned Ticket[]            @relation("TicketAssignee")
  ticketMessages TicketMessage[]
  notices        Notice[]
}

/// A field worker on our own team. One user can hold several skills.
model WorkerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  photo       String   @default("")
  nid         String   @default("")
  nidPhoto    String   @default("")
  /// NID | PASSPORT | BIRTH (birth certificate) | DRIVING
  idType      String   @default("NID")
  businessName String  @default("")
  rejectNote  String   @default("")
  isRider     Boolean  @default(false)
  /// STAFF = our own team. PARTNER = an outside vehicle owner who rents through us.
  kind        String   @default("STAFF")
  /// Partners start unapproved; the admin approves them (and their vehicle) before they can log in.
  approved    Boolean  @default(true)
  /// Partner privilege: new bookings for their vehicle/resort/store go straight to them, skipping the office transfer.
  autoAssign  Boolean  @default(false)
  /// Office switch: list this partner's orders on the admin booking pages (off = the partner handles them alone; the office still finds them on the partner page).
  officeList  Boolean  @default(true)
  available   Boolean  @default(true)
  rating      Float    @default(0)
  ratingCount Int      @default(0)
  joinedAt    DateTime @default(now())

  skills   WorkerSkill[]
  areas    WorkerArea[]
  bookings ServiceBooking[]
  reviews  BookingReview[]
  vehicles Vehicle[]
  properties Property[]
  stores     Store[]
  helpers    User[]   @relation("Helpers")
  ticketStocks TicketStock[]

  @@index([shopId])
}

/// A car, bike, jeep or microbus customers can rent. Owned by a partner (workerId)
/// or by the shop itself (workerId null). offeringId is its type inside the rental category.
model Vehicle {
  id            String          @id @default(cuid())
  shopId        String
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workerId      String?
  worker        WorkerProfile?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  offeringId    String
  offering      ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  title         String
  titleBn       String
  plate         String          @default("")
  seats         Int             @default(2)
  /// Uploaded photo names, comma separated; the first is the cover.
  photos        String          @default("")
  detail        String          @default("")
  detailBn      String          @default("")
  pricePerHour  Int             @default(0)
  pricePerDay   Int             @default(0)
  /// Half-day (6 hours) rate; 0 = not offered.
  pricePerHalfDay Int           @default(0)
  minHours      Int             @default(2)
  /// Short spec tags, comma separated ("149cc, ABS, Fuel injection").
  specs         String          @default("")
  /// PENDING (waiting for admin), APPROVED (bookable), PAUSED (owner hid it), REJECTED
  status        String          @default("PENDING")
  rejectNote    String          @default("")
  sort          Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookings ServiceBooking[]
  routes   VehicleRoute[]

  @@index([shopId, status])
  @@index([workerId])
  @@index([offeringId])
}

model WorkerSkill {
  workerId   String
  worker     WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
}

model WorkerArea {
  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  areaId   String
  area     ServiceArea   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([workerId, areaId])
}

/// The neighbourhoods one shop serves. A booking must point at an active row of its shop.
model ServiceArea {
  id     String  @id @default(cuid())
  shopId String
  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug   String
  name   String
  nameBn String
  charge Int     @default(0)
  sort   Int     @default(0)
  active Boolean @default(true)

  workers   WorkerArea[]
  bookings  ServiceBooking[]
  addresses Address[]
  properties  Property[]

  @@unique([shopId, slug])
}

model ServiceCategory {
  id      String  @id @default(cuid())
  shopId  String
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug    String
  name    String
  nameBn  String
  blurb   String  @default("")
  blurbBn String  @default("")
  icon    String  @default("spark")
  image   String  @default("")
  /// STANDARD visit, LAUNDRY pickup/delivery, TEAM (resort crews), CUSTOM ("write your job"), RENTAL (cars & bikes).
  flow    String  @default("STANDARD")
  /// Two or three letters in front of this category's booking numbers, e.g. CL-10001, CR-10002.
  codePrefix String @default("")
  sort    Int     @default(0)
  active  Boolean @default(true)

  offerings ServiceOffering[]
  workers   WorkerSkill[]
  bookings  ServiceBooking[]
  coupons   Coupon[]

  @@unique([shopId, slug])
}

/// A fixed-price trip package a vehicle offers ("Cox's Bazar to Patuartek", 6–7 h, 7–13 people, ৳4,000).
model VehicleRoute {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name      String
  /// Main attractions on the way, free text.
  spots     String  @default("")
  /// Approximate duration, free text ("6–7 hours").
  hours     String  @default("")
  /// Capacity, free text ("7–13 people").
  capacity  String  @default("")
  price     Int
  sort      Int     @default(0)

  @@index([vehicleId])
}

/// A resort, hotel, cottage or guest house customers can book by the night.
model Property {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Owner partner (WorkerProfile kind PARTNER); null = HANDYO-managed.
  workerId   String?
  worker     WorkerProfile? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  areaId     String
  area       ServiceArea    @relation(fields: [areaId], references: [id])
  /// RESORT, HOTEL, COTTAGE, GUESTHOUSE
  kind       String         @default("RESORT")
  name       String
  nameBn     String
  address    String         @default("")
  addressBn  String         @default("")
  /// Photo names or bundled paths, comma separated; first is the cover.
  photos     String         @default("")
  detail     String         @default("")
  detailBn   String         @default("")
  /// Amenity tags, comma separated ("Sea view, Pool, Breakfast").
  amenities  String         @default("")
  checkIn    String         @default("14:00")
  checkOut   String         @default("12:00")
  policy     String         @default("")
  policyBn   String         @default("")
  /// PENDING, APPROVED, PAUSED, REJECTED
  status     String         @default("PENDING")
  rejectNote String         @default("")
  sort       Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  rooms    RoomType[]
  bookings ServiceBooking[]

  @@index([shopId, status])
  @@index([workerId])
}

/// One bookable room category of a property, with how many of them exist.
model RoomType {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name          String
  nameBn        String   @default("")
  sleeps        Int      @default(2)
  pricePerNight Int
  totalRooms    Int      @default(1)
  amenities     String   @default("")
  photos        String   @default("")
  sort          Int      @default(0)
  active        Boolean  @default(true)

  bookings ServiceBooking[]

  @@index([propertyId])
}

/// A partner's store in the product shop ("বিসমিল্লাহ শুঁটকি শপ"); null owner = HANDYO's own store.
model Store {
  id         String         @id @default(cuid())
  shopId     String
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workerId   String?
  worker     WorkerProfile? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  slug       String
  name       String
  nameBn     String
  /// Logo / cover photo names or bundled paths.
  photos     String         @default("")
  detail     String         @default("")
  detailBn   String         @default("")
  address    String         @default("")
  addressBn  String         @default("")
  /// PENDING, APPROVED, PAUSED, REJECTED
  status     String         @default("PENDING")
  rejectNote String         @default("")
  sort       Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  products Product[]
  orders   ServiceBooking[]

  @@unique([shopId, slug])
  @@index([shopId, status])
}

/// A shelf in the product shop ("শুঁটকি", "বালাচাও", "চাটনি"…), belonging to one shop category (শুঁটকি / আচার).
model ProductGroup {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// The SHOP-flow ServiceCategory this shelf is listed under; null = shown everywhere.
  categoryId String?
  slug       String
  name      String
  nameBn    String
  sort      Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([shopId, slug])
}

/// A product customers can order, sold in one or more variants (250 g, 500 g, 1 kg…).
model Product {
  id        String       @id @default(cuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  groupId   String
  group     ProductGroup @relation(fields: [groupId], references: [id])
  /// The partner store selling it; null = HANDYO's own.
  storeId   String?
  store     Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  slug      String
  name      String
  nameBn    String
  /// Photo names or bundled paths, comma separated; first is the cover.
  photos    String       @default("")
  detail    String       @default("")
  detailBn  String       @default("")
  /// Small label on the card ("সেরা পছন্দ", "নতুন").
  badge     String       @default("")
  sort      Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  variants ProductVariant[]
  items    OrderItem[]

  @@unique([shopId, slug])
  @@index([shopId, active])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  price     Int
  oldPrice  Int     @default(0)
  /// -1 = unlimited
  stock     Int     @default(-1)
  sort      Int     @default(0)
  active    Boolean @default(true)

  items OrderItem[]

  @@index([productId])
}

/// One line of a shop order (a ServiceBooking of the SHOP category); prices are copied at order time.
model OrderItem {
  id        String          @id @default(cuid())
  bookingId String
  booking   ServiceBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  nameBn    String          @default("")
  label     String          @default("")
  unitPrice Int
  qty       Int
  lineTotal Int

  @@index([bookingId])
}

model ServiceOffering {
  id          String          @id @default(cuid())
  categoryId  String
  category    ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  nameBn      String
  detail      String          @default("")
  detailBn    String          @default("")
  /// FIXED, PER_KG, PER_ITEM, PER_HOUR, PER_ROOM, QUOTE (inspection then quote)
  pricing     String          @default("FIXED")
  /// For QUOTE this is the inspection fee.
  price       Int             @default(0)
  minQty      Int             @default(1)
  durationMin Int             @default(60)
  image       String          @default("")
  sort        Int             @default(0)
  active      Boolean         @default(true)
  bookings    ServiceBooking[]
  vehicles    Vehicle[]
  ticketStocks TicketStock[]

  @@unique([categoryId, slug])
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String      @default("বাসা")
  areaId    String
  area      ServiceArea @relation(fields: [areaId], references: [id])
  line      String
  landmark  String      @default("")
  phone     String
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model ServiceBooking {
  id            String          @id @default(cuid())
  code          String          @unique
  shopId        String
  shop          Shop            @relation(fields: [shopId], references: [id])
  customerId    String
  customer      User            @relation("BookingCustomer", fields: [customerId], references: [id])
  categoryId    String
  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  offeringId    String
  offering      ServiceOffering @relation(fields: [offeringId], references: [id])
  areaId        String
  area          ServiceArea     @relation(fields: [areaId], references: [id])
  addressLine   String
  landmark      String          @default("")
  phone         String
  contactName   String          @default("")
  visitDate     String
  visitSlot     String
  notes         String          @default("")
  /// Rental booked as a fixed route package: the route id (if it still exists) and its name as booked.
  routeId       String?
  routeName     String          @default("")
  /// Stays: the property and room type booked; visitDate is check-in, checkOut the last day; rooms × nights.
  propertyId    String?
  roomTypeId    String?
  /// Shop orders: the partner store this parcel comes from.
  storeId       String?
  checkOut      String          @default("")
  nights        Int             @default(0)
  rooms         Int             @default(1)
  guests        Int             @default(1)
  pricing       String
  unitPrice     Int             @default(0)
  quantity      Float           @default(1)
  teamSize      Int             @default(1)
  days          Int             @default(1)
  visitCharge   Int             @default(0)
  /// Coupon applied at booking time; `discount` is already taken off estimatedPrice.
  couponId      String?
  coupon        Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode    String          @default("")
  discount      Int             @default(0)
  /// Office adjustment on the bill (can be negative); partner-requested extras land here once approved.
  extraCharge   Int             @default(0)
  extraNote     String          @default("")
  estimatedPrice Int            @default(0)
  quoteAmount   Int?
  /// NONE, SENT, ACCEPTED, DECLINED
  quoteStatus   String          @default("NONE")
  quoteNote     String          @default("")
  finalPrice    Int?
  /// CASH, BKASH, NAGAD
  paymentMethod String          @default("CASH")
  /// UNPAID, PAID
  paymentStatus String          @default("UNPAID")
  status        String          @default("REQUESTED")
  workerId      String?
  worker        WorkerProfile?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  /// Rentals: the exact vehicle the customer picked.
  vehicleId     String?
  vehicle       Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  cancelReason  String          @default("")
  refundNote    String          @default("")
  adminNote     String          @default("")
  rescheduled   Int             @default(0)
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  events   BookingEvent[]
  photos   BookingPhoto[]
  review   BookingReview?
  chat     BookingThread?
  payments PaymentRecord[]
  tickets  Ticket[]
  property      Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  roomType      RoomType?       @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  store         Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  requests      ChangeRequest[]

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([customerId])
  @@index([workerId, status])
  @@index([status, visitDate])
  @@index([categoryId])
  @@index([areaId])
  @@index([vehicleId])
  @@index([couponId])
  /// Ticket orders: the agent stock the tickets came from.
  ticketStockId String?
  ticketStock   TicketStock? @relation(fields: [ticketStockId], references: [id], onDelete: SetNull)
}

/// Every status change: who, when, from what, to what.
model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus String         @default("")
  toStatus   String
  note       String         @default("")
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String         @default("")
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model BookingPhoto {
  id           String         @id @default(cuid())
  bookingId    String
  booking      ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// CUSTOMER, BEFORE, AFTER
  kind         String
  path         String
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
}

model BookingReview {
  id         String         @id @default(cuid())
  bookingId  String         @unique
  booking    ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User           @relation(fields: [customerId], references: [id])
  workerId   String?
  worker     WorkerProfile? @relation(fields: [workerId], references: [id], onDelete: SetNull)
  rating     Int
  comment    String
  published  Boolean        @default(true)
  createdAt  DateTime       @default(now())
}

model PaymentRecord {
  id        String         @id @default(cuid())
  bookingId String
  booking   ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider  String
  amount    Int
  /// RECORDED now; a real gateway can add PENDING / FAILED later.
  status    String         @default("RECORDED")
  reference String         @default("")
  createdAt DateTime       @default(now())
}

model BookingThread {
  id        String               @id @default(cuid())
  bookingId String               @unique
  booking   ServiceBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  updatedAt DateTime             @updatedAt
  createdAt DateTime             @default(now())
  messages  BookingChatMessage[]
  reads     BookingThreadRead[]
}

model BookingChatMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    BookingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

model BookingThreadRead {
  threadId String
  thread   BookingThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  readAt   DateTime      @default(now())

  @@id([threadId, userId])
}

/// Customer care chat, one per customer per shop, not tied to a booking.
model CareThread {
  id         String        @id @default(cuid())
  shopId     String
  shop       Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CareCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?         @relation("CareAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status     String        @default("OPEN")
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())
  messages   CareMessage[]
  reads      CareRead[]

  @@unique([customerId, shopId])
  @@index([shopId, status])
}

model CareMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    CareThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User       @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

model CareRead {
  threadId String
  thread   CareThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  readAt   DateTime   @default(now())

  @@id([threadId, userId])
}

model Ticket {
  id         String          @id @default(cuid())
  code       String          @unique
  shopId     String
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation("TicketOwner", fields: [userId], references: [id])
  bookingId  String?
  booking    ServiceBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subject    String
  /// COMPLAINT, REFUND, WORKER, OTHER
  category   String          @default("OTHER")
  /// LOW, NORMAL, HIGH, URGENT
  priority   String          @default("NORMAL")
  /// OPEN, PENDING, RESOLVED, CLOSED
  status     String          @default("OPEN")
  assigneeId String?
  assignee   User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  messages   TicketMessage[]
  reads      TicketRead[]

  @@index([shopId, status, priority])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model TicketRead {
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  readAt   DateTime @default(now())

  @@id([ticketId, userId])
}

/// Ready-made replies for the support inbox.
model ReplyTemplate {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title  String
  body   String
  sort   Int    @default(0)

  @@index([shopId])
}

model Notice {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("INFO")
  title     String
  body      String
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// One-time codes for phone sign-in. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Faq {
  id         String  @id @default(cuid())
  question   String
  questionBn String
  answer     String
  answerBn   String
  sort       Int     @default(0)
  active     Boolean @default(true)
}

/// Per-shop key/value settings (helpline, hero text, worker share, payment switches).
model Setting {
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  key    String
  value  String

  @@id([shopId, key])
}

/// Named counters. "booking" hands out the one running serial shared by every category and shop.
model Sequence {
  name  String @id
  value Int    @default(0)
}

/// Something that needs the HANDYO office's approval before it happens:
/// an extra charge a partner wants to add, or a cancellation asked by a customer or partner.
model ChangeRequest {
  id          String         @id @default(cuid())
  shopId      String
  bookingId   String
  booking     ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// EXTRA (add money to the bill), CANCEL (cancel the booking)
  kind        String
  amount      Int            @default(0)
  note        String         @default("")
  /// PENDING, APPROVED, REJECTED
  status      String         @default("PENDING")
  requesterId String
  requester   User           @relation("RequestedBy", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterRole String       @default("")
  deciderId   String?
  decider     User?          @relation("DecidedBy", fields: [deciderId], references: [id], onDelete: SetNull)
  decisionNote String        @default("")
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  @@index([shopId, status])
  @@index([bookingId])
}

/// Tickets an agent (partner) holds for one offering. `sold` counts booked tickets; left = qty - sold.
model TicketStock {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  offeringId String
  offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  qty        Int      @default(0)
  sold       Int      @default(0)
  note       String   @default("")
  photos     String   @default("")
  /// PENDING → APPROVED (office); PAUSED = agent marked stock out; REJECTED.
  status     String   @default("PENDING")
  rejectNote String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookings   ServiceBooking[]

  @@index([shopId, status])
  @@index([offeringId, status])
  @@index([workerId])
}
